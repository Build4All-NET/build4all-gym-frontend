// FILE: lib/features/admin/shared/presentation/cubit/branch_cubit.dart
//
// PURPOSE:
//   Loads branches ONCE from the backend and keeps them available across
//   all admin screens. Wrap the admin section of the app with BlocProvider
//   so every screen can access the branch list without re-fetching.
// ─────────────────────────────────────────────────────────────────────────────
import 'package:flutter_bloc/flutter_bloc.dart';
import '../data/models/branch_option_model.dart';
import '../data/services/admin_branches_service.dart';

// ── States ────────────────────────────────────────────────────────────────────
abstract class BranchState {}
class BranchInitial  extends BranchState {}
class BranchLoading  extends BranchState {}
class BranchLoaded   extends BranchState {
  final List<BranchOptionModel> branches;
  BranchLoaded(this.branches);
}
class BranchError    extends BranchState {
  final String message;
  BranchError(this.message);
}

// ── Cubit ─────────────────────────────────────────────────────────────────────
class BranchCubit extends Cubit<BranchState> {
  final AdminBranchesService _service;

  BranchCubit() : _service = AdminBranchesService(),
        super(BranchInitial());

  Future<void> loadBranches() async {
    if (state is BranchLoaded) return;
    emit(BranchLoading());
    try {
      final branches = await _service.getBranches();
      print('✅ Branches loaded: ${branches.length}');
      emit(BranchLoaded(branches));
    } catch (e) {
      print('❌ BranchCubit error: $e'); // ← ADD THIS
      emit(BranchError(e.toString().replaceFirst('Exception: ', '')));
    }
  }

  Future<void> reload() async {
    emit(BranchLoading());
    try {
      final branches = await _service.getBranches();
      emit(BranchLoaded(branches));
    } catch (e) {
      emit(BranchError(e.toString().replaceFirst('Exception: ', '')));
    }
  }

  // Call this when admin switches branch to filter screen data
  BranchOptionModel? branchById(int id) {
    if (state is BranchLoaded) {
      return (state as BranchLoaded).branches
          .where((b) => b.id == id)
          .firstOrNull;
    }
    return null;
  }
}